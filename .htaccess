# Social Network on Apache (Strato). The folder settings of the main site (index page, no
# directory listings) still apply; this only adds to them.

# Compress the text files (HTML, CSS, JavaScript, JSON), so pages load faster
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>
